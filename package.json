{
  "devDependencies": {
    "@types/react": "^19.2.14",
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "start": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd front && npm run dev",
    "dev:backend": "cd back && npm run dev",
    "postinstall": "cd front && npm install && cd ../back && npm install"
  }
}
